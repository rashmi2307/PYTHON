def quick_sort(numbers):

    if len(numbers) <= 1:
        return numbers

    pivot = numbers[0]

    less = []
    equal = []
    greater = []

    for num in numbers:
        if num < pivot:
            less.append(num)
        elif num > pivot:
            greater.append(num)
        else:
            equal.append(num)

    return quick_sort(less) + equal + quick_sort(greater)

numbers = [20, 3, 14, 1, 5]

print("Before sorting:", numbers)

sorted_numbers = quick_sort(numbers)

print("After sorting: ", sorted_numbers)

# Verify original list was not modified
print("Original list: ", numbers)
