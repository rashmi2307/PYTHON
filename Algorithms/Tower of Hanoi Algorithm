def hanoi_solver(n):

    source = list(range(n, 0, -1))
    auxiliary = []
    target = []

    moves = []

    def record_state():
        moves.append(f"{source} {auxiliary} {target}")

    record_state()

    def move_disks(num_disks, from_rod, to_rod, aux_rod):
        if num_disks == 1:
            disk = from_rod.pop()
            to_rod.append(disk)
            record_state()
        else:
            move_disks(num_disks - 1, from_rod, aux_rod, to_rod)

            disk = from_rod.pop()
            to_rod.append(disk)
            record_state()

            move_disks(num_disks - 1, aux_rod, to_rod, from_rod)

    move_disks(n, source, target, auxiliary)

    return '\n'.join(moves)
print(hanoi_solver(2))
