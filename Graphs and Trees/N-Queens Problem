def dfs_n_queens(n):

    if n < 1:
        return []

    solutions = []

    def is_safe(board, row, col):
        for previous_row in range(row):
            previous_col = board[previous_row]

            same_column = previous_col == col
            same_diagonal = abs(previous_col - col) == abs(previous_row - row)

            if same_column or same_diagonal:
                return False

        return True

    def dfs(board, row):
        if row == n:
            solutions.append(board[:])
            return

        for col in range(n):
            if is_safe(board, row, col):
                board.append(col)
                dfs(board, row + 1)
                board.pop()

    dfs([], 0)

    return solutions
print(dfs_n_queens(0))
print(dfs_n_queens(1))
print(dfs_n_queens(2))
print(dfs_n_queens(3))
print(dfs_n_queens(4))
